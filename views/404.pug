extends layout

block content
  .empty-state(style="text-align: center; padding: 50px 20px;")
    h1(style="font-size: 72px; margin-bottom: 10px; color: #e74c3c;") 404
    h2(style="margin-bottom: 20px; color: #2c3e50;") Page Not Found
    p(style="color: #7f8c8d; margin-bottom: 30px;") The page or resource you are looking for does not exist.
    a.btn(href="/" style="display: inline-block;") Back to Home
