extends layout

block content
  h1= title
  
  .header-actions
    a.btn(href='/task/new') + Create New Task
  
  if tasks && tasks.length > 0
    ul.task-list
      each task in tasks
        li.task-item(class=task.isDone ? 'done' : '')
          .task-info
            .task-title(class=task.isDone ? 'done' : '')= task.title
            .task-user by #{task.user}
          .task-actions
            if !task.isDone
              form(method='POST', action=`/task/${task._id}/done`)
                button.btn.btn-success(type='submit') Mark Done
            form(method='POST', action=`/task/${task._id}/delete`)
              button.btn.btn-danger(type='submit') Delete
  else
    .empty-state
      p No tasks yet!
      p Start by creating your first task.
